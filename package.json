{
  "name": "project-erp",
  "version": "0.1.0",
  "private": true,
  "description": "App de almacén: materiales por cliente y obra, listados, inventario y recordatorios.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace @erp/api",
    "dev:web": "npm run dev --workspace @erp/web",
    "build": "npm run build --workspaces --if-present",
    "db:migrate": "npm run prisma:migrate --workspace @erp/api",
    "db:deploy": "npm run prisma:deploy --workspace @erp/api",
    "db:generate": "npm run prisma:generate --workspace @erp/api",
    "db:seed": "npm run prisma:seed --workspace @erp/api",
    "db:studio": "npm run prisma:studio --workspace @erp/api"
  },
  "engines": {
    "node": ">=20"
  }
}
