# --- Base de datos (PostgreSQL / Neon) ---
# Cadena de conexión de Neon (rama `development` en local, `production` en Render).
# Ejemplo: postgresql://usuario:password@ep-xxxx.eu-central-1.aws.neon.tech/erp?sslmode=require
DATABASE_URL="postgresql://usuario:password@host/erp?sslmode=require"

# --- Servidor ---
PORT=3001
WEB_ORIGIN="http://localhost:3000"

# --- Auth ---
JWT_SECRET="cambia-esta-clave-en-produccion"
JWT_EXPIRES_IN="7d"

# --- Email ---
# MAIL_TRANSPORT = "json" (no envía, imprime en consola) | "smtp" (envía de verdad)
MAIL_TRANSPORT="json"
# Remitente. Con Gmail debe ser la misma cuenta que SMTP_USER.
MAIL_FROM="Almacen <tu-cuenta@gmail.com>"
# Copia interna que recibe todos los listados enviados:
INTERNAL_EMAIL="oficina@example.com"
# Solo si MAIL_TRANSPORT="smtp" (Gmail):
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="tu-cuenta@gmail.com"
# Contraseña de aplicación de Gmail (requiere verificación en 2 pasos):
SMTP_PASS=""

# --- Recordatorio diario ---
REMINDER_ENABLED=true
REMINDER_HOUR=8
REMINDER_MINUTE=0
