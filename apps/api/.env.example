# --- Base de datos ---
# Desarrollo local (SQLite). Para producción cambia el provider en
# prisma/schema.prisma a "postgresql" y usa una URL de Postgres.
DATABASE_URL="file:./dev.db"

# --- Servidor ---
PORT=3001
WEB_ORIGIN="http://localhost:3000"

# --- Auth ---
JWT_SECRET="cambia-esta-clave-en-produccion"
JWT_EXPIRES_IN="7d"

# --- Email ---
# MAIL_TRANSPORT = "json" (no envía, imprime en consola) | "smtp"
MAIL_TRANSPORT="json"
MAIL_FROM="Almacen <almacen@example.com>"
# Copia interna que recibe todos los listados enviados:
INTERNAL_EMAIL="oficina@example.com"
# Solo si MAIL_TRANSPORT="smtp":
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""

# --- Recordatorio diario ---
REMINDER_ENABLED=true
REMINDER_HOUR=8
REMINDER_MINUTE=0
